# MongoDB connection string
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/la_fabrica?retryWrites=true&w=majority

# Server port
PORT=5000

# JSON body limit
JSON_BODY_LIMIT=2mb

# Allowed CORS origins (comma-separated for multiple origins, e.g. https://app.lafabrica.com)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000,http://localhost:8080,http://127.0.0.1:3000,http://127.0.0.1:5000

# Node environment (production or development)
NODE_ENV=development
